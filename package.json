{
  "name": "@alma-cdk/project",
  "description": "Opinionated CDK Project “Framework”",
  "repository": {
    "type": "git",
    "url": "https://github.com/alma-cdk/project.git"
  },
  "scripts": {
    "build": "projen build",
    "bump": "projen bump",
    "bump:releasable-commits": "projen bump:releasable-commits",
    "clobber": "projen clobber",
    "compat": "projen compat",
    "compile": "projen compile",
    "default": "projen default",
    "docgen": "projen docgen",
    "eject": "projen eject",
    "eslint": "projen eslint",
    "format": "projen format",
    "package": "projen package",
    "package-all": "projen package-all",
    "package:go": "projen package:go",
    "package:js": "projen package:js",
    "package:python": "projen package:python",
    "post-compile": "projen post-compile",
    "post-upgrade": "projen post-upgrade",
    "pre-compile": "projen pre-compile",
    "release": "projen release",
    "release:3.x": "projen release:3.x",
    "test": "projen test",
    "test:update": "projen test:update",
    "test:watch": "projen test:watch",
    "unbump": "projen unbump",
    "upgrade": "projen upgrade",
    "watch": "projen watch",
    "projen": "pnpm exec projen"
  },
  "author": {
    "name": "Alma Media",
    "email": "opensource@almamedia.dev",
    "organization": true
  },
  "devDependencies": {
    "@alma-cdk/construct-library": "1",
    "@types/jest": "^30",
    "@types/node": "^22",
    "@types/nunjucks": "^3.2.6",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "aws-cdk-lib": "2.220.0",
    "commit-and-tag-version": "^12",
    "constructs": "10.7.2",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "eslint-import-resolver-typescript": "^4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30",
    "jest-junit": "^17",
    "jsii": "~6.0.7",
    "jsii-diff": "^1.126.0",
    "jsii-docgen": "^10.5.0",
    "jsii-pacmak": "^1.126.0",
    "jsii-rosetta": "~6.0.7",
    "prettier": "^3.8.1",
    "projen": "^0.101.23",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "typescript": "^5.9"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.220.0",
    "constructs": "^10.7.2"
  },
  "dependencies": {
    "change-case": "^4.1.2",
    "nunjucks": "^3.2.4"
  },
  "bundledDependencies": [
    "change-case",
    "nunjucks"
  ],
  "pnpm": {},
  "keywords": [
    "aws",
    "aws-cdk",
    "awscdk",
    "cdk"
  ],
  "engines": {
    "node": ">= 22 <= 26"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.19.0",
      "onFail": "ignore"
    }
  },
  "main": "lib/index.js",
  "license": "Apache-2.0",
  "stability": "stable",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.0.0",
  "packageManager": "pnpm@11.19.0",
  "jest": {
    "coverageProvider": "v8",
    "testMatch": [
      "<rootDir>/@(src|test)/**/*(*.)@(spec|test).ts?(x)",
      "<rootDir>/@(src|test)/**/__tests__/**/*.ts?(x)",
      "<rootDir>/@(projenrc)/**/*(*.)@(spec|test).ts?(x)",
      "<rootDir>/@(projenrc)/**/__tests__/**/*.ts?(x)"
    ],
    "clearMocks": true,
    "collectCoverage": true,
    "coverageReporters": [
      "json",
      "lcov",
      "clover",
      "cobertura",
      "text"
    ],
    "coverageDirectory": "coverage",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "watchPathIgnorePatterns": [
      "/node_modules/"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "test-reports"
        }
      ]
    ],
    "transform": {
      "^.+\\.[t]sx?$": [
        "ts-jest",
        {
          "tsconfig": "test/tsconfig.json"
        }
      ]
    }
  },
  "types": "lib/index.d.ts",
  "jsii": {
    "outdir": "dist",
    "targets": {
      "python": {
        "distName": "alma-cdk.project",
        "module": "alma_cdk.project"
      },
      "go": {
        "moduleName": "github.com/alma-cdk/project-go"
      }
    },
    "tsconfig": "tsconfig.json",
    "validateTsconfig": "strict"
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.ts and run \"pnpm exec projen\"."
}
